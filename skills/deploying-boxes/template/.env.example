# Copy to .env for local development. Production values are set with `amp secrets set`.

# Sign in with Amp confidential client (`amp oauth-clients create --type server ...`).
AMP_OAUTH_CLIENT_ID=
AMP_OAUTH_CLIENT_SECRET=
# Optional. Defaults to <AMP_DEPLOYMENT_URL>/auth/callback on a Box. Required for local dev.
AMP_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Random secret of at least 32 characters, used to encrypt session cookies.
APP_SESSION_SECRET=

# Optional comma-separated Amp user IDs (OIDC `sub`). Empty allows every signed-in Amp user.
APP_ALLOWED_USER_IDS=

# Where the SQLite database lives. Default: $AMP_DEPLOYMENT_DATA_DIRECTORY/app.sqlite on a Box,
# data/app.sqlite locally.
DATABASE_PATH=data/app.sqlite
